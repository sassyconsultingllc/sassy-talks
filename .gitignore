# Build outputs
**/build/
**/dist/
**/target/
**/out/
# Android NDK / CMake build cache (machine-specific, regenerated every build)
**/.cxx/

# Gradle
**/.gradle/
**/gradle-wrapper.jar
**/local.properties

# Node
**/node_modules/
**/package-lock.json

# IDE
**/.idea/
**/.vscode/
*.iml

# OS
.DS_Store
Thumbs.db
desktop.ini

# Android
*.apk
*.aab
*.dex
*.class
*.hprof

# Rust/Tauri
**/target/
**/*.rs.bk

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.*
!.env.example

# Keystore (sensitive)
*.jks
*.keystore
**/keystore/
# Local signing config (plaintext passwords) — CI uses env-var secrets instead
**/keystore.properties

# Firebase / Google services config (contains API keys) — inject in CI as a secret
**/google-services.json

# Mercury code-review bundles (generated artifacts, not source)
mercury_*

# Editor/backup scratch files
*.bak

# Stray native-build snapshot artifacts (compiled libs + source tarballs that
# duplicate the live android-native/ crate — never commit these)
**/sassytalkie-android-native-build/
sassytalkie-native-*.tar.gz
ios-native.zip

# Local test suites
**/tests-local/

# Cloudflare Wrangler local state (Miniflare R2/KV/DO emulator caches)
**/.wrangler/

# Holding pen for files staged for deletion (keep out of source tree, don't push)
/delete/

# Nested archive leftovers (never commit)
**/sassytalkie-android-native-build.zip
**/playstore-complete.zip
**/core.zip


# Machine-local cargo overrides. A committed .cargo/config.toml pinned
# OPUS_SRC_DIR and every Android linker to one developer's Windows paths
# (and to NDK 26 while Gradle wanted 27), so the native build only ever
# worked on that laptop — CI's first real Rust build failed on it
# immediately. build.rs discovers the opus sources from the registry and
# cargo-ndk supplies the linkers, so no committed override is needed.
android-native/.cargo/config.toml
