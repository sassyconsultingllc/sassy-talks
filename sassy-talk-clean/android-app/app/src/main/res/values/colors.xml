<?xml version="1.0" encoding="utf-8"?>
<!--
  Non-Compose chrome palette (splash window, status/nav bar fallbacks). Kept in
  sync with the Tauri desktop reference (app.css :root) and the Compose tokens in
  ui/theme/Color.kt. Slate backgrounds + teal accent; coral is reserved for the
  active/TX/warning state and lives only in the Compose layer.
-->
<resources>
    <!-- Dark slate backgrounds (Tauri bg-dark / bg-medium / bg-card) -->
    <color name="bg_dark">#0F172A</color>
    <color name="bg_mid">#1E293B</color>
    <color name="bg_card">#1E293B</color>

    <!-- Accent: teal (Tauri teal / teal-light / teal-dark) -->
    <color name="accent">#14B8A6</color>
    <color name="accent_light">#2DD4BF</color>
    <color name="accent_dark">#0D9488</color>

    <!-- Status colors (Tauri status-online / error / warning) -->
    <color name="green">#22C55E</color>
    <color name="red">#EF4444</color>
    <color name="yellow">#EAB308</color>

    <!-- Text colors (Tauri text-primary / text-secondary / text-muted) -->
    <color name="white">#F8FAFC</color>
    <color name="gray">#94A3B8</color>
    <color name="light_gray">#64748B</color>

    <!-- Material theme -->
    <color name="colorPrimary">@color/accent</color>
    <color name="colorPrimaryDark">@color/bg_dark</color>
    <color name="colorAccent">@color/accent</color>
</resources>
